/* Single source of truth for embedded commands.
 *   INTERNAL(id, "name")  ->  int bash_internal_<id>(int argc, char **argv)   a bash builtin
 *   EXTERNAL(id, "name")  ->  int bash_external_<id>(int argc, char **argv)   behaves like an external
 *                             program (cat, grep, ...) but is only a function call in this process.
 * The prefix records where the command comes from in real bash (`type -t`). */
INTERNAL(true, "true")
INTERNAL(false, "false")
INTERNAL(colon, ":")
INTERNAL(echo, "echo")
INTERNAL(printf, "printf")
EXTERNAL(cat, "cat")
INTERNAL(kill, "kill")
INTERNAL(pwd, "pwd")
INTERNAL(cd, "cd")
INTERNAL(exit, "exit")
INTERNAL(return, "return")
INTERNAL(break, "break")
INTERNAL(continue, "continue")
INTERNAL(export, "export")
INTERNAL(unset, "unset")
INTERNAL(local, "local")
INTERNAL(declare, "declare")
INTERNAL(typeset, "typeset")
INTERNAL(readonly, "readonly")
INTERNAL(shift, "shift")
INTERNAL(set, "set")
INTERNAL(read, "read")
INTERNAL(let, "let")
INTERNAL(lbracket, "[")
INTERNAL(test, "test")
INTERNAL(dblbracket, "[[")
INTERNAL(wait, "wait")
INTERNAL(trap, "trap")
INTERNAL(eval, "eval")
INTERNAL(source, "source")
INTERNAL(dot, ".")
INTERNAL(exec, "exec")
INTERNAL(command, "command")
INTERNAL(builtin, "builtin")
INTERNAL(mapfile, "mapfile")
INTERNAL(readarray, "readarray")
EXTERNAL(sleep, "sleep")
EXTERNAL(ls, "ls")
EXTERNAL(wc, "wc")
EXTERNAL(head, "head")
EXTERNAL(tail, "tail")
EXTERNAL(mkdir, "mkdir")
EXTERNAL(rmdir, "rmdir")
EXTERNAL(rm, "rm")
EXTERNAL(touch, "touch")
EXTERNAL(basename, "basename")
EXTERNAL(dirname, "dirname")
EXTERNAL(realpath, "realpath")
EXTERNAL(cp, "cp")
EXTERNAL(mv, "mv")
EXTERNAL(chmod, "chmod")
EXTERNAL(grep, "grep")
EXTERNAL(sort, "sort")
EXTERNAL(uniq, "uniq")
EXTERNAL(seq, "seq")
EXTERNAL(tr, "tr")
EXTERNAL(cut, "cut")
EXTERNAL(env, "env")
EXTERNAL(date, "date")
EXTERNAL(tee, "tee")
EXTERNAL(whoami, "whoami")
EXTERNAL(mktemp, "mktemp")
